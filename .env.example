# Copy to .env. Nothing here is required to run `make doctor` or `make test`.
# config.py reads this file at import and never overrides a real shell variable.

# --- credentials ------------------------------------------------------------
# The Agent SDK reuses an existing Claude Code login; set this only if you have
# no login on this Mac.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional. Without it JARVIS speaks through `say -v Daniel`, which is British,
# offline, free, and noticeably less good.
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE_ID=            # phase 2: scripts/voices.py auditions and picks

# --- the knobs worth reaching for first -------------------------------------
# Every field in config.py is JARVIS_<SECTION>_<FIELD>; these are the ones that
# actually get tuned. `python -m jarvis --config` prints the resolved tree.

# JARVIS_VERBOSE=1                # per-stage timings on the console
# JARVIS_WAKE_THRESHOLD=0.5       # lower = more sensitive; below 0.4 it hears the TV
# JARVIS_VAD_SILENCE_MS=300       # the endpoint window; below 250 it clips people
# JARVIS_BRAIN_MODEL=claude-sonnet-5
# JARVIS_STT_BACKEND=parakeet     # parakeet | whisper
# JARVIS_TTS_BACKEND=elevenlabs   # elevenlabs | say
# JARVIS_HUD_PORT=8765
# JARVIS_STATE_DIR=~/.jarvis      # memory and logs; deliberately outside the repo
